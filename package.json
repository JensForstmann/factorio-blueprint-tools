{
  "name": "@jensforstmann/factorio-blueprint-tools",
  "version": "2.2.0",
  "description": "JS/TS library for encoding and decoding Factorio blueprint strings (fully typed)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsc && tsdown",
    "clean": "prettier ./src ./test --write",
    "test": "nyc mocha test/**/*.ts",
    "prepare": "npm run build"
  },
  "author": "Jens Forstmann",
  "license": "MIT",
  "dependencies": {
    "pako": "^3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JensForstmann/factorio-blueprint-tools.git"
  },
  "homepage": "https://github.com/JensForstmann/factorio-blueprint-tools",
  "bugs": {
    "url": "https://github.com/JensForstmann/factorio-blueprint-tools/issues"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/pako": "^2.0.4",
    "chai": "^6.2.2",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/**/*"
  ],
  "mocha": {
    "import": [
      "tsx"
    ],
    "require": [
      "source-map-support/register"
    ],
    "extension": [
      "ts"
    ]
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "test/"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "tsdown": {
    "entry": "src/index.ts",
    "platform": "neutral",
    "format": [
      "esm",
      "cjs"
    ],
    "dts": {
      "sourcemap": true
    },
    "exports": true,
    "sourcemap": true
  }
}
